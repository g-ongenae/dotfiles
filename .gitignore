# Git ignore
__pycache__/
*.pyc
.gitconfig.local

# Development tools of the JavaScript files, installed by `npm ci`
node_modules/

# Sym links
# Running copies of the committed files
# that are at a different place
*.link
*.link.*

# Zsh generated files
run/.zsh_history*
run/.zcompdump*
run/.zsh_sessions/*

# Git submodule
# Bug on my computer?
zsh/plugins/zsh-autosuggestions
zsh/plugins/zsh-syntax-highlighting
